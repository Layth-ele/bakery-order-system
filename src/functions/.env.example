# Copy to src/functions/.env (git-ignored) and fill in before deploying.
# Firebase loads these as Cloud Functions params. See docs/email-system.md.

# Sender for every customer email. The domain must be verified in Resend.
EMAIL_FROM="Your Bakery <orders@yourdomain.com>"

# Public https URL of this app. Used for "View your orders" buttons and
# password-reset links (which open /reset-password on this site).
APP_URL="https://yourdomain.com"

# The Resend API key is a SECRET — do not put it here. Set it with:
#   firebase functions:secrets:set RESEND_API_KEY
